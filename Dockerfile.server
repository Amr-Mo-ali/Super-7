# Explicit role image for the separated durable server deployment.
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.11.2@sha256:c4f5de312ee66d46810635ffc5df34a1973ba753e7241ce3a08ef979ddd7bea5 /uv /uvx /usr/local/bin/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
WORKDIR /app
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --home-dir /home/app --create-home app
COPY pyproject.toml uv.lock README.md ./
# The application image needs no model runtime. Install the reviewed locked
# dependencies, omitting the PyPI CUDA branch and the GUI OpenCV distribution.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --quiet --frozen --no-dev --no-emit-project \
      --prune torch --prune torchvision --prune opencv-python \
      --output-file /tmp/server-requirements.txt \
    && uv export --quiet --frozen --no-dev --no-emit-project --no-hashes \
      --prune torch --prune torchvision --prune opencv-python \
      --output-file /tmp/server-constraints.txt \
    && UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 UV_LINK_MODE=copy \
      uv pip install --system --require-hashes --no-deps \
      --requirement /tmp/server-requirements.txt
COPY --chown=app:app src ./src
USER app
CMD ["python", "-c", "raise SystemExit('Explicit durable role command required.')"]

FROM runtime AS database-admin
COPY --chown=app:app scripts/server_database.py ./scripts/server_database.py

FROM runtime AS gpu-worker
USER root
# This is the official PyTorch CUDA 12.6 channel, pinned to the pair already
# exercised by Dockerfile.gpu-benchmark. Wheel hash attestation remains a
# separate rollout gate; see the server runbook.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 UV_LINK_MODE=copy \
      uv pip install --system --index https://download.pytorch.org/whl/cu126 \
      --constraint /tmp/server-constraints.txt \
      "torch==2.13.0+cu126" "torchvision==0.28.0+cu126" \
    && python -c "import torch, torchvision; assert torch.__version__ == '2.13.0+cu126'; assert torchvision.__version__ == '0.28.0+cu126'; assert torch.version.cuda == '12.6'"
USER app
