# Copy outside the repository and pass as docker compose --env-file.
# Use a reviewed image digest, or a unique revision tag whose image ID was checked.
SUPER7_PROD_IMAGE=football-analysis:prod-REVIEWED-REVISION
SUPER7_PROD_MODEL_ID=REVIEWED-MODEL-ID
SUPER7_PROD_API_ENV=/opt/super7-secrets/production/api.env
SUPER7_PROD_WORKER_ENV=/opt/super7-secrets/production/worker.env
SUPER7_PROD_DISPATCHER_ENV=/opt/super7-secrets/production/dispatcher.env
