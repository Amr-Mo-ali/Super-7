FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

COPY --from=ghcr.io/astral-sh/uv:0.11.2@sha256:c4f5de312ee66d46810635ffc5df34a1973ba753e7241ce3a08ef979ddd7bea5 /uv /uvx /usr/local/bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --create-home --home-dir /home/app app

COPY pyproject.toml uv.lock README.md ./

# The locked PyPI Torch wheel pulls CUDA on Linux. Export the reviewed lock
# without those three packages, then install the matching official CPU wheels.
# Ultralytics declares opencv-python, but this image deliberately retains only
# the project's locked headless OpenCV distribution, as the existing image does.
# The durable factory imports httpx, currently in the dev group; install only
# its two missing locked distributions rather than the entire dev toolchain.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv export --quiet --frozen --no-dev --no-emit-project \
        --prune torch --prune torchvision --prune opencv-python \
        --output-file /tmp/trial-requirements.txt \
    && uv export --quiet --frozen --no-dev --no-emit-project --no-hashes \
        --output-file /tmp/trial-constraints.txt \
    && UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 UV_LINK_MODE=copy \
        uv pip install --system --require-hashes --no-deps \
        --requirement /tmp/trial-requirements.txt \
    && UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 UV_LINK_MODE=copy \
        uv pip install --system --no-deps "httpcore==1.0.9" "httpx==0.28.1"

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_HTTP_TIMEOUT=300 UV_HTTP_RETRIES=5 UV_LINK_MODE=copy uv pip install --system \
        --torch-backend cpu \
        --constraint /tmp/trial-constraints.txt \
        "torch==2.13.0+cpu" "torchvision==0.28.0+cpu" \
    && mkdir --parents /app/debug /models \
    && chown --recursive app:app /app /models

COPY --chown=app:app src ./src

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "from urllib.request import urlopen; response = urlopen('http://127.0.0.1:8000/openapi.json', timeout=3); assert response.status == 200" || exit 1

CMD ["python", "-c", "raise SystemExit('Explicit runtime role required; use a reviewed role command.')"]
