SUPER7_DURABLE_DISPATCHER_ENABLED=1
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=super7
POSTGRES_USER=super7_dispatcher
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_MIN_SIZE=0
POSTGRES_POOL_MAX_SIZE=4
POSTGRES_POOL_ACQUIRE_TIMEOUT_SECONDS=5
POSTGRES_POOL_MAX_WAITERS=8
POSTGRES_POOL_OPEN_TIMEOUT_SECONDS=10
POSTGRES_POOL_CLOSE_TIMEOUT_SECONDS=10
POSTGRES_REQUIRED_SCHEMA_VERSION=sprint2_slice5_video_integrity
