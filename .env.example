# Operational limits for the upload endpoint.
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=900
REQUEST_DEADLINE_SECONDS=900
CALLBACK_TIMEOUT_SECONDS=10
MAX_QUEUED_ANALYSES=10

# Durable job persistence is disabled until the Phase 3 runtime migration is enabled.
# Set DATABASE_URL only through deployment secrets; never commit production credentials.
PERSISTENCE_ENABLED=false
# DATABASE_URL=postgresql+psycopg://super7:replace-me@localhost:5432/super7
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_SQL_ECHO=false
WORKER_POLL_INTERVAL_SECONDS=1
LEASE_DURATION_SECONDS=900
LEASE_RENEWAL_INTERVAL_SECONDS=60
DEFAULT_MAX_ATTEMPTS=3
CALLBACK_POLL_INTERVAL_SECONDS=1

# Shared read-only video volume; videoUrl must be a safe relative filename within this directory.
VIDEO_STORAGE_ROOT=/videos

# Models are supplied by the read-only ./models host-volume mount in docker-compose.yml.
MODEL_PATH=/models/yolo11n.pt
BALL_MODEL_PATH=/models/yolo11n.pt

DEBUG_ARTIFACTS_ENABLED=false
DEBUG_SAVE_VIDEO=false
DEBUG_SAVE_FRAMES=false
DEBUG_SAVE_ON_FAILURE=false
DEBUG_RETAINED_SESSIONS=0
