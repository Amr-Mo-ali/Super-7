# Operational limits for the upload endpoint.
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=900
REQUEST_DEADLINE_SECONDS=900

# Shared read-only video volume; videoUrl must be a safe relative filename within this directory.
VIDEO_STORAGE_ROOT=/videos

# Models are supplied by the read-only ./models host-volume mount in docker-compose.yml.
MODEL_PATH=/models/yolo11n.pt
BALL_MODEL_PATH=/models/yolo11n.pt

DEBUG_ARTIFACTS_ENABLED=false
DEBUG_SAVE_VIDEO=false
DEBUG_SAVE_FRAMES=false
DEBUG_SAVE_ON_FAILURE=false
DEBUG_RETAINED_SESSIONS=0
